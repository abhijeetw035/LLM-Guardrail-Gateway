# LLM Guardrail Gateway — Environment Variables
#
# Copy this file to .env and fill in the values, OR export them in your shell.
# The gateway reads all config from environment variables at startup.

# ─────────────────────────────────────────────────────────────────────────────
# Gateway Settings
# ─────────────────────────────────────────────────────────────────────────────

# HTTP listen address (default: :8080)
# GATEWAY_LISTEN_ADDR=:8080

# Maximum request body size in bytes (default: 524288 = 512 KB)
# GATEWAY_MAX_BODY_BYTES=524288

# Log verbosity: "info", "warn", or "error" (default: info)
# GATEWAY_LOG_LEVEL=info

# Sliding window buffer size in bytes (default: 512)
# GATEWAY_WINDOW_SIZE=512

# Path to the .policy DSL file (default: configs/dev.policy)
# GATEWAY_POLICY_FILE=configs/dev.policy

# ─────────────────────────────────────────────────────────────────────────────
# LLM Provider  ← THE MAIN THING TO CONFIGURE
# ─────────────────────────────────────────────────────────────────────────────

# Which LLM backend to use.
# Options: mock (default), groq, gemini, openai, custom
LLM_PROVIDER=mock

# API key for the chosen provider (not needed for mock).
# LLM_API_KEY=

# Override the model name (optional — each provider has a sensible default).
# Groq default:   llama-3.3-70b-versatile
# Gemini default: gemini-2.0-flash
# OpenAI default: gpt-4o-mini
# LLM_MODEL=

# Override the API base URL (required for LLM_PROVIDER=custom, optional otherwise).
# Example for Ollama local: http://localhost:11434/v1
# LLM_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Quick-Start Examples
# ─────────────────────────────────────────────────────────────────────────────

# --- Groq (free, fast, recommended for testing) ---
# Sign up at https://console.groq.com → API Keys → Create key
# LLM_PROVIDER=groq
# LLM_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google Gemini (free tier available) ---
# Get key at https://aistudio.google.com/app/apikey
# LLM_PROVIDER=gemini
# LLM_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- OpenAI ---
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Local Ollama ---
# LLM_PROVIDER=custom
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

# ─────────────────────────────────────────────────────────────────────────────
# Mock LLM (only used when LLM_PROVIDER=mock)
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the local mock LLM server (default: http://localhost:9090)
# MOCK_LLM_ADDR=http://localhost:9090

# ─────────────────────────────────────────────────────────────────────────────
# Redis (leave REDIS_ADDR empty to disable rate limiting and quota features)
# ─────────────────────────────────────────────────────────────────────────────

# REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=

# Max requests per tenant per minute (default: 60)
# RATE_LIMIT_PER_MINUTE=60

# Max tokens per tenant per UTC day (default: 100000)
# DAILY_TOKEN_QUOTA=100000
